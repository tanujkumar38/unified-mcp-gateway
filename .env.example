# Google Flow MCP Server Configuration

# Path to authentic Google Chrome executable
# Windows default: C:\Program Files\Google\Chrome\Application\chrome.exe
CHROME_PATH="C:\\Program Files\\Google\\Chrome\\Application\\chrome.exe"

# Chrome Remote Debugging (CDP) Port
CHROME_CDP_PORT=9222

# Persistent Chrome user profile directory (preserves your Google account login)
# FLOW_USER_DATA_DIR="C:\\Users\\tanuj\\AppData\\Local\\google-flow-mcp\\chrome-profile"

# Target Google Flow URL
GOOGLE_FLOW_URL="https://flow.google"

# Anti-Ban Velocity Governor Cooldown (in milliseconds)
# Minimum delay between successive video generations to respect Google Labs limits
FLOW_GENERATION_COOLDOWN_MS=20000

# Kinetic Humanized Delay Jitter (in milliseconds)
FLOW_DELAY_MIN_MS=1200
FLOW_DELAY_MAX_MS=3200

# Optional Streamable HTTP Transport
ENABLE_HTTP=false
PORT=3000
HOST=127.0.0.1
